---
import Base from '../layouts/Base.astro';
import Lanes from '../components/Lanes.astro';
import Glyph from '../components/Glyph.astro';
import { strategies } from '../data/strategies';

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Trading B(u)y Signal: a rule-based crypto trading system"
  description="Five rule-based trading strategies, backtested and traded live. How each one works and when it went live."
>
  <section class="hero wrap">
    <h1>A crypto trading system that follows rules, not hunches.</h1>
    <p class="lede">
      Five strategies, each backtested before it trades real money, all executed automatically.
      This site explains how they work and how they perform.
    </p>
    <Lanes />
  </section>

  <section class="strategies wrap" aria-labelledby="strategies-title">
    <h2 id="strategies-title">The strategies</h2>
    <p class="section-intro">
      They look for different things: some buy sharp dips and wait for the rebound, others follow
      trends or rank coins by momentum. Running them side by side smooths out the bad stretches of
      any single one.
    </p>

    <ul class="list">
      {strategies.map((s) => (
        <li class="item" id={s.id}>
          <Glyph kind={s.glyph} label={`Diagram of how ${s.name} trades`} />
          <div class="body">
            <h3>{s.name}</h3>
            <p class="meta">
              <span>{s.timeframe}</span>
              <span>{s.market}</span>
              <span>Live since <time datetime={s.liveSince}>{fmt.format(new Date(`${s.liveSince}T00:00:00Z`))}</time></span>
            </p>
            <p class="summary">{s.summary}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="legend">
      <span class="dot buy" aria-hidden="true"></span>Entry
      <span class="dot sell" aria-hidden="true"></span>Exit
    </p>
  </section>

  <section class="flow wrap" aria-labelledby="flow-title">
    <h2 id="flow-title">How a trade happens</h2>
    <ol class="steps">
      <li>
        <h3>A signal fires</h3>
        <p>When a candle closes, each strategy checks its rules on TradingView and sends a buy or sell signal.</p>
      </li>
      <li>
        <h3>The bridge checks it</h3>
        <p>A small server checks position limits, available cash and overlaps with other strategies before acting.</p>
      </li>
      <li>
        <h3>The order goes to OKX</h3>
        <p>The order is placed on OKX Europe and every fill is logged, so results can be checked trade by trade.</p>
      </li>
    </ol>
  </section>

  <section class="next wrap">
    <p>
      Backtests, forward tests and live results for each strategy are being moved to this new site
      and will appear here soon.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }
  h1 {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }
  .lede {
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    max-width: 38rem;
    margin: 1.5rem 0 3.5rem;
  }

  section + section {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .section-intro {
    max-width: 38rem;
    margin: 0.75rem 0 2rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .item {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
  }
  .item:target {
    background: var(--surface);
  }
  .body {
    max-width: 40rem;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 650;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.375rem 0 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .summary {
    margin: 0;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot.sell {
    margin-left: 0.75rem;
  }
  .dot.buy {
    background: var(--buy);
  }
  .dot.sell {
    background: var(--sell);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .steps li {
    counter-increment: step;
    border-top: 3px solid var(--ink);
    padding-top: 1rem;
  }
  .steps h3::before {
    content: counter(step) '. ';
    color: var(--muted);
  }
  .steps p {
    margin: 0.5rem 0 0;
  }

  .next p {
    max-width: 38rem;
    margin: 0;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border-left: 3px solid var(--buy);
  }

  @media (max-width: 48rem) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .item {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
