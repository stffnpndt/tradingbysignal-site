---
// Hero chart "one thread": the combined portfolio as one bright gold line, the
// strategies as faint strands behind it, all on one log scale and indexed to
// their own start. No figures; hover or tap a name to light up its strand.
import backtests from '../data/backtests.json';
import { strategies } from '../data/strategies';

type B = { curve: [string, number, number, number][] };
const bt = backtests as unknown as Record<string, B>;

const strands = strategies.filter((s) => bt[s.id]).map((s) => ({ id: s.id, name: s.name, d: bt[s.id] }));
const all = bt.portfolio;

const t0 = Date.parse('2018-01-01');
const t1 = Date.parse(all.curve[all.curve.length - 1][0]);
const W = 1000;
const H = 360;
const X = (s: string) => ((Date.parse(s) - t0) / (t1 - t0)) * W;
const vals = [...strands.flatMap((s) => s.d.curve.map((p) => p[1])), ...all.curve.map((p) => p[1])];
const lo = Math.log(Math.min(...vals) * 0.9);
const hi = Math.log(Math.max(...vals) * 1.05);
const Y = (v: number) => H - 12 - ((Math.log(v) - lo) / (hi - lo)) * (H - 24);
const path = (c: [string, number, number, number][]) =>
  'M' + c.map((p) => `${X(p[0]).toFixed(1)},${Y(p[1]).toFixed(1)}`).join('L');

const years: { label: string; x: number; minor: boolean }[] = [];
for (let y = 2018; y <= new Date(t1).getUTCFullYear(); y++) {
  const x = (X(`${y}-01-01`) / W) * 100;
  if (x >= 0 && x <= 88) years.push({ label: String(y), x, minor: y % 2 === 1 });
}
const lines = strands.map((s, i) => ({ ...s, i, d: path(s.d.curve) }));
const allPath = path(all.curve);
const end = all.curve[all.curve.length - 1];
---

<figure class="thread" aria-labelledby="thread-caption">
  <div class="axis" aria-hidden="true">
    {years.map((y) => (
      <span class:list={['year', { edge: y.x < 2, minor: y.minor }]} style={`left:${y.x}%`}>{y.label}</span>
    ))}
    <span class="today" style="left:100%">Today</span>
  </div>

  <div class="plot">
    {years.map((y) => (
      <span class="gridline" style={`left:${y.x}%`} aria-hidden="true" />
    ))}
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Backtests of today's rules from 2018 to today: four strategies as thin strands and all of them together as one brighter line.">
      {lines.map((l) => (
        <g class="strand" data-id={l.id} data-href={`#${l.id}`} style={`--i:${l.i}`}>
          <path class="line" d={l.d} />
          <path class="hit" d={l.d} />
        </g>
      ))}
      <g class="strand together" data-id="portfolio" data-href="#portfolio-title">
        <path class="all" d={allPath} />
        <path class="hit" d={allPath} />
      </g>
    </svg>
    <span class="end" style={`top:${(Y(end[1]) / H) * 100}%`} aria-hidden="true" />
  </div>

  <ul class="names">
    <li class="all-name"><a href="#portfolio-title" data-for="portfolio">All together</a></li>
    {lines.map((l) => (
      <li><a href={`#${l.id}`} data-for={l.id}>{l.name}</a></li>
    ))}
  </ul>

  <figcaption id="thread-caption">
    Backtests of today’s rules, 2018 to today, on one log scale. The figures are on each strategy’s page.
  </figcaption>
</figure>

<style>
  .thread {
    margin: 0;
  }
  .axis {
    position: relative;
    height: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .year,
  .today {
    position: absolute;
    top: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }
  .year.edge {
    transform: none;
  }
  .today {
    transform: translateX(-100%);
    color: var(--gold-bright);
    font-weight: 600;
  }
  .plot {
    position: relative;
    height: clamp(14rem, 30vw, 20rem);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .line,
  .all {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    animation: draw 2s cubic-bezier(0.45, 0.05, 0.25, 1) both;
  }
  .line {
    stroke: var(--gold);
    stroke-width: 1.2;
    opacity: 0.38;
    animation-delay: calc(var(--i) * 160ms + 200ms);
    transition:
      opacity 250ms,
      stroke-width 250ms;
  }
  .hit {
    fill: none;
    stroke: transparent;
    stroke-width: 14;
    vector-effect: non-scaling-stroke;
    pointer-events: stroke;
    cursor: pointer;
  }
  .all {
    stroke: var(--gold-bright);
    stroke-width: 2.6;
    filter: drop-shadow(0 0 6px rgba(230, 201, 136, 0.55));
    animation-delay: 900ms;
  }
  .thread.focus .strand.together:not(.on) .all {
    opacity: 0.45;
  }
  .thread.focus .line {
    opacity: 0.12;
  }
  .thread.focus .strand.on .line {
    opacity: 1;
    stroke-width: 2;
  }
  .end {
    position: absolute;
    right: 0;
    width: 10px;
    height: 10px;
    margin: -5px -5px 0 0;
    border-radius: 50%;
    background: var(--gold-bright);
    box-shadow: 0 0 0 4px var(--stone), 0 0 14px 4px rgba(230, 201, 136, 0.55);
    opacity: 0;
    animation: pop 300ms ease-out 2.8s forwards;
  }
  .names {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }
  .names li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .names li::before {
    content: '';
    width: 14px;
    height: 1.5px;
    background: var(--gold);
    opacity: 0.6;
  }
  .names .all-name a {
    color: var(--gold-bright);
    font-weight: 600;
  }
  .names .all-name::before {
    height: 2.5px;
    background: var(--gold-bright);
    opacity: 1;
  }
  .names a {
    color: var(--on-dark-muted);
    text-decoration: none;
  }
  .names a:hover,
  .names a.on {
    color: var(--on-dark);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes pop {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line,
    .all,
    .end {
      animation: none;
      opacity: revert;
    }
    .end {
      opacity: 1;
    }
  }
  @media (max-width: 40rem) {
    .year.minor {
      display: none;
    }
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('figure.thread');
  if (fig) {
    let armed: string | null = null;
    const strands = [...fig.querySelectorAll<SVGGElement>('.strand')];
    const names = [...fig.querySelectorAll<HTMLAnchorElement>('.names a')];
    const light = (id: string | null) => {
      if (!id) armed = null;
      fig.classList.toggle('focus', !!id);
      strands.forEach((s) => s.classList.toggle('on', s.dataset.id === id));
      names.forEach((n) => n.classList.toggle('on', n.dataset.for === id));
    };
    strands.forEach((s) => {
      // Mouse: a click jumps to the section. Touch: the first tap highlights
      // the line, a second tap on the same line jumps.
      s.addEventListener('click', (e) => {
        const touch = (e as PointerEvent).pointerType !== 'mouse';
        if (touch && armed !== s.dataset.id) {
          armed = s.dataset.id ?? null;
          return;
        }
        if (s.dataset.href) location.hash = s.dataset.href;
      });
      s.addEventListener('pointerenter', () => light(s.dataset.id ?? null));
      s.addEventListener('pointerleave', (e) => (e as PointerEvent).pointerType === 'mouse' && light(null));
    });
    names.forEach((n) => {
      n.addEventListener('pointerenter', (e) => (e as PointerEvent).pointerType === 'mouse' && light(n.dataset.for ?? null));
      n.addEventListener('pointerleave', (e) => (e as PointerEvent).pointerType === 'mouse' && light(null));
      n.addEventListener('focus', () => light(n.dataset.for ?? null));
      n.addEventListener('blur', () => light(null));
    });
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target as Element).closest?.('.strand')) light(null);
    });
  }
</script>
