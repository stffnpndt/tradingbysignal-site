---
// Animated weekly ranking for Cross-Sectional Momentum. Five coins re-sort
// by their recent return each week; the leaders go long, the laggard goes
// short, and the number of longs follows the Bitcoin regime.
// Illustrative numbers only.

const weeks = [
  { up: true, r: { BTC: 6, ETH: 11, SOL: 18, XRP: -4, BNB: 2 } },
  { up: true, r: { BTC: 9, ETH: 4, SOL: 7, XRP: 15, BNB: -3 } },
  { up: false, r: { BTC: -5, ETH: -12, SOL: -9, XRP: -7, BNB: 1 } },
  { up: false, r: { BTC: -2, ETH: -6, SOL: -14, XRP: 3, BNB: -4 } },
];
const coins = ['BTC', 'ETH', 'XRP', 'BNB', 'SOL'];
const MAX = 20; // % that fills half the bar track

// Server-render week 1 so the board works without JavaScript.
const w0 = weeks[0];
const order0 = [...coins].sort((a, b) => w0.r[b as keyof typeof w0.r] - w0.r[a as keyof typeof w0.r]);
const role = (rank: number, up: boolean) =>
  rank < (up ? 2 : 1) ? 'long' : rank === coins.length - 1 ? 'short' : 'none';
const label = { long: 'Long', short: 'Short', none: 'No position' } as const;
---

<figure class="board" data-weeks={JSON.stringify(weeks)} data-max={MAX}>
  <div class="bar-top">
    <p class="week" aria-live="polite"><span data-week>Week 1</span></p>
    <p class="regime" data-regime-wrap>
      <span class="chip" data-regime>{w0.up ? 'Bitcoin above trend' : 'Bitcoin below trend'}</span>
      <span class="mix" data-mix>{w0.up ? 'Two longs, one short' : 'One long, one short'}</span>
    </p>
  </div>

  <div class="head-row" aria-hidden="true">
    <span>Coin</span><span class="c">Return, past weeks</span><span class="r">Position</span>
  </div>

  <ol class="rows" style={`--n:${coins.length}`}>
    {coins.map((c) => {
      const rank = order0.indexOf(c);
      const ret = w0.r[c as keyof typeof w0.r];
      const pos = role(rank, w0.up);
      const w = (Math.min(Math.abs(ret), MAX) / MAX) * 50;
      return (
        <li class={`row ${pos}`} data-coin={c} style={`--rank:${rank}`}>
          <span class="coin">{c}</span>
          <span class="track">
            <span class="zero"></span>
            <span class="fill" style={`left:${ret >= 0 ? 50 : 50 - w}%;width:${w}%`}></span>
          </span>
          <span class="ret">{ret > 0 ? '+' : ''}{ret}%</span>
          <span class="tag">{label[pos]}</span>
        </li>
      );
    })}
  </ol>

  <div class="controls">
    <button type="button" data-prev aria-label="Previous week">Previous week</button>
    <button type="button" data-next aria-label="Next week">Next week</button>
    <span class="hint">Illustrative numbers</span>
  </div>
</figure>

<style>
  .board {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.015);
  }
  .bar-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .week {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.625rem;
    color: #f2f1ee;
  }
  .regime {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--on-dark-muted);
  }
  .chip {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--gold);
    color: var(--gold-bright);
    border-radius: 999px;
    font-size: 0.8125rem;
    transition: border-color 300ms, color 300ms;
  }
  .chip.down {
    border-color: var(--on-dark-muted);
    color: var(--on-dark);
  }

  .head-row,
  .row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 4rem 7rem;
    gap: 1rem;
    align-items: center;
  }
  .head-row {
    font-size: 0.75rem;
    color: var(--on-dark-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .head-row .c {
    grid-column: 2 / 4;
  }
  .head-row .r {
    text-align: right;
  }

  .rows {
    --row: 3.25rem;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    height: calc(var(--n) * var(--row));
  }
  .row {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--row);
    top: calc(var(--rank) * var(--row));
    border-bottom: 1px solid var(--rule);
    transition: top 700ms cubic-bezier(0.6, 0, 0.25, 1);
  }
  .coin {
    font-weight: 600;
    color: #f2f1ee;
  }
  .track {
    position: relative;
    height: 6px;
    background: rgba(231, 231, 229, 0.06);
    border-radius: 3px;
  }
  .zero {
    position: absolute;
    left: 50%;
    top: -6px;
    bottom: -6px;
    width: 1px;
    background: var(--on-dark-muted);
    opacity: 0.5;
  }
  .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 3px;
    background: var(--on-dark-muted);
    transition:
      left 600ms ease,
      width 600ms ease,
      background-color 300ms;
  }
  .ret {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--on-dark);
    font-size: 0.9375rem;
  }
  .tag {
    justify-self: end;
    font-size: 0.8125rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    color: var(--on-dark-muted);
    border: 1px solid transparent;
    transition:
      background-color 300ms,
      color 300ms,
      border-color 300ms;
  }
  .row.long .fill {
    background: var(--gold-bright);
    box-shadow: 0 0 8px rgba(230, 201, 136, 0.5);
  }
  .row.long .tag {
    background: var(--gold);
    color: var(--stone);
    font-weight: 600;
  }
  .row.short .fill {
    background: var(--on-dark);
  }
  .row.short .tag {
    border-color: var(--on-dark);
    color: var(--on-dark);
    font-weight: 600;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .controls button {
    font: inherit;
    font-size: 0.875rem;
    color: var(--on-dark);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms, color 200ms;
  }
  .controls button:hover {
    border-color: var(--gold);
    color: var(--gold-bright);
  }
  .hint {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--on-dark-muted);
  }

  @media (max-width: 40rem) {
    .head-row,
    .row {
      grid-template-columns: 2.75rem 1fr 3.25rem 5.5rem;
      gap: 0.6rem;
    }
    .tag {
      font-size: 0.75rem;
      padding: 0.15rem 0.45rem;
    }
  }
</style>

<script>
  type Week = { up: boolean; r: Record<string, number> };
  const board = document.querySelector<HTMLElement>('figure.board');

  if (board) {
    const weeks: Week[] = JSON.parse(board.dataset.weeks || '[]');
    const MAX = Number(board.dataset.max || 20);
    const rows = [...board.querySelectorAll<HTMLElement>('.row')];
    const weekEl = board.querySelector<HTMLElement>('[data-week]')!;
    const regimeEl = board.querySelector<HTMLElement>('[data-regime]')!;
    const mixEl = board.querySelector<HTMLElement>('[data-mix]')!;
    const labels = { long: 'Long', short: 'Short', none: 'No position' };
    let idx = 0;
    let timer = 0;

    const show = (i: number) => {
      idx = (i + weeks.length) % weeks.length;
      const w = weeks[idx];
      const order = Object.keys(w.r).sort((a, b) => w.r[b] - w.r[a]);
      const nLong = w.up ? 2 : 1;

      weekEl.textContent = `Week ${idx + 1}`;
      regimeEl.textContent = w.up ? 'Bitcoin above trend' : 'Bitcoin below trend';
      regimeEl.classList.toggle('down', !w.up);
      mixEl.textContent = w.up ? 'Two longs, one short' : 'One long, one short';

      for (const row of rows) {
        const coin = row.dataset.coin!;
        const rank = order.indexOf(coin);
        const ret = w.r[coin];
        const role = rank < nLong ? 'long' : rank === order.length - 1 ? 'short' : 'none';
        const width = (Math.min(Math.abs(ret), MAX) / MAX) * 50;

        row.style.setProperty('--rank', String(rank));
        row.classList.remove('long', 'short', 'none');
        row.classList.add(role);
        const fill = row.querySelector<HTMLElement>('.fill')!;
        fill.style.left = `${ret >= 0 ? 50 : 50 - width}%`;
        fill.style.width = `${width}%`;
        row.querySelector('.ret')!.textContent = `${ret > 0 ? '+' : ''}${ret}%`;
        row.querySelector('.tag')!.textContent = labels[role];
      }
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const play = () => {
      if (reduce || timer) return;
      timer = window.setInterval(() => show(idx + 1), 3600);
    };
    const pause = () => {
      clearInterval(timer);
      timer = 0;
    };

    board.querySelector('[data-next]')!.addEventListener('click', () => {
      pause();
      show(idx + 1);
    });
    board.querySelector('[data-prev]')!.addEventListener('click', () => {
      pause();
      show(idx - 1);
    });
    board.addEventListener('pointerenter', pause);
    board.addEventListener('pointerleave', () => {
      if (!board.contains(document.activeElement)) play();
    });

    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : pause()), { threshold: 0.4 }).observe(board);
  }
</script>
