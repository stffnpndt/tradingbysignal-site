---
// Illustration of how the Ichimoku strategy trades: a choppy phase it sits
// out, an entry once the trend is confirmed and the Bitcoin regime is on,
// a protective stop, and the exit when momentum fades. Synthetic data.

// Deterministic pseudo-random so the drawing never changes between builds.
let seed = 11;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

const W = 760;
const H = 300;
const step = 5;

// Price path (y grows downward): chop, rally, roll-over.
const price: [number, number][] = [];
let y = 175;
for (let x = 10; x <= 750; x += step) {
  let target: number;
  if (x < 300) target = 172 + Math.sin(x / 38) * 16;
  else if (x < 585) target = 172 - ((x - 300) / 285) * 108;
  else target = 64 + ((x - 585) / 165) * 62;
  y += (target - y) * 0.22 + (rand() - 0.5) * 9;
  price.push([x, y]);
}

// Cloud: two smoothed copies of price, shifted forward (as Ichimoku does).
const ema = (k: number) => {
  let v = price[0][1];
  return price.map(([, py]) => (v = v + k * (py - v)));
};
const fast = ema(0.08);
const slow = ema(0.035);
const shift = 6; // points
const cloudTop: string[] = [];
const cloudBottom: string[] = [];
for (let i = 0; i < price.length; i++) {
  const j = Math.max(0, i - shift);
  const x = price[i][0];
  cloudTop.push(`${x},${Math.min(fast[j], slow[j]) + 14}`);
  cloudBottom.push(`${x},${Math.max(fast[j], slow[j]) + 22}`);
}
const cloudPath = `M${cloudTop.join(' L')} L${cloudBottom.reverse().join(' L')} Z`;

const pricePath = 'M' + price.map(([x, py]) => `${x},${py.toFixed(1)}`).join(' L');
const at = (x: number) => price.reduce((a, b) => (Math.abs(b[0] - x) < Math.abs(a[0] - x) ? b : a));

const entry = at(345);
const exit = at(640);
const stopY = entry[1] + 26;
const regimeOn = 315;
---

<figure class="diagram">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Illustration: the strategy stays out during a choppy phase, enters once the trend is confirmed and the Bitcoin regime is on, places a protective stop, and exits when momentum fades.">
    {[60, 120, 180, 240].map((gy) => <line class="grid" x1="0" x2={W} y1={gy} y2={gy} />)}

    <path class="cloud" d={cloudPath} />

    <rect class="zone" x="10" y="20" width={regimeOn - 20} height="236" rx="3" />

    <line class="stop" x1={entry[0]} x2={exit[0]} y1={stopY} y2={stopY} />

    <path class="price" pathLength="1" d={pricePath} />

    <circle class="buy" style="--d:1.1s" cx={entry[0]} cy={entry[1]} r="6" />
    <circle class="sell" style="--d:1.5s" cx={exit[0]} cy={exit[1]} r="6" />

    <g class="regime">
      <rect class="off" x="10" y="272" width={regimeOn - 10} height="10" rx="2" />
      <rect class="on" x={regimeOn} y="272" width={W - 10 - regimeOn} height="10" rx="2" />
    </g>

    <g class="num" style="--d:0.3s"><circle cx="40" cy="44" r="11" /><text x="40" y="44">1</text></g>
    <g class="num" style="--d:1.1s"><circle cx={entry[0] - 26} cy={entry[1] - 24} r="11" /><text x={entry[0] - 26} y={entry[1] - 24}>2</text></g>
    <g class="num" style="--d:1.3s"><circle cx={entry[0] + 110} cy={stopY + 22} r="11" /><text x={entry[0] + 110} y={stopY + 22}>3</text></g>
    <g class="num" style="--d:1.5s"><circle cx={exit[0] + 26} cy={exit[1] - 24} r="11" /><text x={exit[0] + 26} y={exit[1] - 24}>4</text></g>
    <g class="num" style="--d:0.6s"><circle cx={regimeOn + 24} cy="262" r="11" /><text x={regimeOn + 24} y="262">5</text></g>
  </svg>

  <ol class="key">
    <li><strong>Choppy market:</strong> price jumps around the cloud and some checks fail, so the strategy stays out.</li>
    <li><strong>Entry:</strong> all six checks agree, including the Bitcoin regime.</li>
    <li><strong>Protective stop:</strong> set below the entry, based on recent volatility.</li>
    <li><strong>Exit:</strong> momentum fades and the position closes, well before the trend fully reverses.</li>
    <li><strong>Bitcoin regime:</strong> grey while off, gold while on. It only gates new entries.</li>
  </ol>
</figure>

<style>
  .diagram {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .cloud {
    fill: var(--gold);
    opacity: 0.24;
  }
  .zone {
    fill: none;
    stroke: var(--rule);
    stroke-dasharray: 3 4;
  }
  .price {
    fill: none;
    stroke: var(--on-dark);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .stop {
    stroke: var(--on-dark-muted);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
    opacity: 0;
  }
  .buy {
    fill: var(--gold-bright);
    filter: drop-shadow(0 0 6px rgba(230, 201, 136, 0.7));
  }
  .sell {
    fill: var(--stone);
    stroke: var(--on-dark);
    stroke-width: 2;
  }
  .regime .off {
    fill: var(--rule);
  }
  .regime .on {
    fill: var(--gold);
    opacity: 0.85;
  }
  .num circle {
    fill: var(--stone-2);
    stroke: var(--on-dark-muted);
    stroke-width: 1;
  }
  .num text {
    fill: var(--on-dark);
    font: 600 12px var(--sans);
    text-anchor: middle;
    dominant-baseline: central;
  }
  @media (max-width: 40rem) {
    .num circle {
      r: 20px;
    }
    .num text {
      font-size: 22px;
    }
    .price {
      stroke-width: 3;
    }
  }

  .buy,
  .sell,
  .num {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.3);
  }

  .diagram.drawn .price {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.45, 0.05, 0.25, 1);
    stroke-dashoffset: 0;
  }
  .diagram.drawn .stop {
    opacity: 1;
    transition: opacity 400ms ease 1.3s;
  }
  .diagram.drawn .buy,
  .diagram.drawn .sell,
  .diagram.drawn .num {
    opacity: 1;
    transform: none;
    transition:
      opacity 250ms ease-out var(--d, 0s),
      transform 400ms cubic-bezier(0.3, 1.5, 0.6, 1) var(--d, 0s);
  }

  .key {
    margin: 1.5rem 0 0;
    padding-left: 1.4rem;
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    display: grid;
    gap: 0.35rem;
  }
  .key strong {
    color: var(--on-dark);
    font-weight: 600;
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('figure.diagram');
  if (fig) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          fig.classList.add('drawn');
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(fig);
  }
</script>
