---
// Illustration of how RSI Mean Reversion trades, on daily closes: a dip in
// an uptrend, the first oversold days only counted, then equal tranches on
// each further oversold day, and one exit for the whole position once the
// short-term RSI recovers. Synthetic data; the oscillator values are drawn
// by hand, not computed, so no settings are implied.

const closes = [
  100, 100.8, 100.4, 101.6, 102.3, 101.9, 103.1, 103.8, 103.2, 104.6, 105.3, 104.9, 106.2, 107.0,
  105.6, 104.1, 102.4, 100.9, 99.6, 98.9, 100.8, 103.6, 104.9, 105.8, 106.6, 107.4,
];
const osc = [55, 68, 52, 74, 80, 58, 79, 84, 30, 76, 82, 60, 85, 88, 24, 8, 4, 3, 2, 1.5, 42, 81, 86, 84, 88, 90];
const counted = [15, 16];
const buys = [17, 18, 19];
const exitIdx = 21;

const W = 760;
const H = 320;
const x0 = 40;
const dx = 26.5;
const X = (i: number) => x0 + i * dx;
const Y = (p: number) => 24 + ((109 - p) / 11) * 166;
const oTop = 222;
const oH = 76;
const OY = (v: number) => oTop + ((100 - v) / 100) * oH;
const zoneTop = OY(12);
const neutral = OY(50);

const line = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L');
const pricePath = line(closes.map((c, i) => [X(i), Y(c)]));
const oscPath = line(osc.map((v, i) => [X(i), OY(v)]));

let e = closes[0] - 4;
const trend = closes.map((c) => (e = e + 0.06 * (c - e)));
const trendPath = line(trend.map((v, i) => [X(i), Y(v)]));

const avg = buys.reduce((s, i) => s + closes[i], 0) / buys.length;
---

<figure class="diagram">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Illustration: during an uptrend, price dips for several days. The first oversold days are only counted, then three equal tranches are bought on the following oversold days. When the short-term RSI recovers, the whole position is sold at the close.">
    {[60, 120, 180].map((gy) => <line class="grid" x1="0" x2={W} y1={gy} y2={gy} />)}

    <path class="trend" d={trendPath} />
    <line class="avg" x1={X(buys[0]) - 6} x2={X(exitIdx)} y1={Y(avg)} y2={Y(avg)} />
    <path class="price" pathLength="1" d={pricePath} />

    {counted.map((i) => <circle class="count" style={`--d:${0.9 + (i - 15) * 0.15}s`} cx={X(i)} cy={Y(closes[i])} r="4.5" />)}
    {buys.map((i, k) => <circle class="buy" style={`--d:${1.25 + k * 0.15}s`} cx={X(i)} cy={Y(closes[i])} r="6" />)}
    <circle class="sell" style="--d:1.9s" cx={X(exitIdx)} cy={Y(closes[exitIdx])} r="6" />

    <g class="panel">
      <rect class="zone" x="20" y={zoneTop} width={W - 40} height={oTop + oH - zoneTop} />
      <line class="neutral" x1="20" x2={W - 20} y1={neutral} y2={neutral} />
      <line class="base" x1="20" x2={W - 20} y1={oTop + oH} y2={oTop + oH} />
      <path class="osc" pathLength="1" d={oscPath} />
    </g>

    <g class="num" style="--d:0.95s"><circle cx={X(15) + 4} cy={Y(closes[15]) - 26} r="11" /><text x={X(15) + 4} y={Y(closes[15]) - 26}>1</text></g>
    <g class="num" style="--d:1.4s"><circle cx={X(18) - 6} cy={Y(closes[18]) + 30} r="11" /><text x={X(18) - 6} y={Y(closes[18]) + 30}>2</text></g>
    <g class="num" style="--d:1.6s"><circle cx={X(20) + 4} cy={Y(avg) + 20} r="11" /><text x={X(20) + 4} y={Y(avg) + 20}>3</text></g>
    <g class="num" style="--d:1.9s"><circle cx={X(exitIdx) + 24} cy={Y(closes[exitIdx]) + 20} r="11" /><text x={X(exitIdx) + 24} y={Y(closes[exitIdx]) + 20}>4</text></g>
    <g class="num" style="--d:1s"><circle cx={X(12)} cy={zoneTop + 10} r="11" /><text x={X(12)} y={zoneTop + 10}>5</text></g>
  </svg>

  <ol class="key">
    <li><strong>The dip begins:</strong> the uptrend is intact and the short-term RSI drops into oversold. The first oversold days are only counted, not bought.</li>
    <li><strong>Scaling in:</strong> each further oversold day adds one equal tranche, up to three.</li>
    <li><strong>Average price:</strong> every tranche bought lower pulls the average entry down.</li>
    <li><strong>Exit:</strong> the short-term RSI is back above neutral, and the whole position is sold at the close.</li>
    <li><strong>Short-term RSI:</strong> the shaded band is the oversold zone, the dashed line is neutral.</li>
  </ol>
</figure>

<style>
  .diagram {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .trend {
    fill: none;
    stroke: var(--gold);
    stroke-width: 6;
    opacity: 0.18;
    stroke-linecap: round;
  }
  .price,
  .osc {
    fill: none;
    stroke: var(--on-dark);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .osc {
    stroke: var(--on-dark-muted);
    stroke-width: 1.5;
  }
  .avg {
    stroke: var(--gold);
    stroke-width: 1.3;
    stroke-dasharray: 5 4;
    opacity: 0;
  }
  .count {
    fill: var(--stone);
    stroke: var(--on-dark-muted);
    stroke-width: 1.5;
  }
  .buy {
    fill: var(--gold-bright);
    filter: drop-shadow(0 0 6px rgba(230, 201, 136, 0.7));
  }
  .sell {
    fill: var(--stone);
    stroke: var(--on-dark);
    stroke-width: 2;
  }
  .zone {
    fill: var(--gold);
    opacity: 0.16;
  }
  .neutral {
    stroke: var(--on-dark-muted);
    stroke-dasharray: 3 4;
    opacity: 0.6;
  }
  .base {
    stroke: var(--rule);
  }
  .num circle {
    fill: var(--stone-2);
    stroke: var(--on-dark-muted);
    stroke-width: 1;
  }
  .num text {
    fill: var(--on-dark);
    font: 600 12px var(--sans);
    text-anchor: middle;
    dominant-baseline: central;
  }
  @media (max-width: 40rem) {
    .num circle {
      r: 20px;
    }
    .num text {
      font-size: 22px;
    }
    .price {
      stroke-width: 3;
    }
  }

  .count,
  .buy,
  .sell,
  .num {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.3);
  }
  .diagram.drawn .price,
  .diagram.drawn .osc {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.45, 0.05, 0.25, 1);
    stroke-dashoffset: 0;
  }
  .diagram.drawn .avg {
    opacity: 1;
    transition: opacity 400ms ease 1.6s;
  }
  .diagram.drawn .count,
  .diagram.drawn .buy,
  .diagram.drawn .sell,
  .diagram.drawn .num {
    opacity: 1;
    transform: none;
    transition:
      opacity 250ms ease-out var(--d, 0s),
      transform 400ms cubic-bezier(0.3, 1.5, 0.6, 1) var(--d, 0s);
  }

  .key {
    margin: 1.5rem 0 0;
    padding-left: 1.4rem;
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    display: grid;
    gap: 0.35rem;
  }
  .key strong {
    color: var(--on-dark);
    font-weight: 600;
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('figure.diagram');
  if (fig) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          fig.classList.add('drawn');
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(fig);
  }
</script>
