---
// Illustration of how ATR Mean Reversion trades, on daily candles: an order
// below the low that is never reached, a weak close in a restless market, the
// fill during the next sell-off and the sale at that day's close. A small
// panel below shows the daily ranges widening. Synthetic data.

type C = [number, number, number, number]; // open, high, low, close
const candles: C[] = [
  [100, 101.5, 99.4, 101],
  [101, 102.2, 100.5, 101.8],
  [101.8, 102.5, 101, 101.4],
  [101.4, 103, 101.1, 102.6],
  [102.6, 103.4, 101.9, 102.2],
  [102.2, 102.8, 100.4, 102.0],
  [102.0, 102.6, 100.9, 101.7],
  [101.7, 103.2, 101.4, 102.9],
  [102.9, 104, 102.3, 103.6],
  [103.6, 104.2, 102.6, 103],
  [103, 105.5, 101.5, 104.8],
  [104.8, 106, 102.4, 102.9],
  [102.9, 103.6, 99, 99.6],
  [99.6, 101.8, 97.9, 101.2],
  [101.2, 102.4, 99.8, 100.4],
  [100.4, 100.9, 96.2, 96.6],
  [96.6, 97.4, 93.2, 96.4],
  [96.4, 99.2, 95.3, 98.6],
  [98.6, 100.4, 97.8, 99.9],
  [99.9, 101.6, 99.1, 100.8],
  [100.8, 101.2, 99.4, 100.1],
  [100.1, 102.3, 99.8, 101.9],
];

const W = 760;
const H = 300;
const x0 = 48;
const dx = 31;
const cw = 14;
const X = (i: number) => x0 + i * dx;
const Y = (p: number) => 24 + ((106.5 - p) / 13.5) * 176;

const missIdx = 13; // order placed after candle 12, not reached
const missLimit = 97.4;
const fillIdx = 16; // order placed after candle 15, filled
const limit = 94.4;
const exitPrice = candles[fillIdx][3];

// Volatility panel: daily range bars, gold while short-term range runs
// above the longer-term average.
const ranges = candles.map(([, h, l]) => h - l);
const avg = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
const restless = ranges.map((_, i) => {
  if (i < 4) return false;
  const short = avg(ranges.slice(i - 4, i + 1));
  const long = avg(ranges.slice(Math.max(0, i - 14), i + 1));
  return short > long * 1.05;
});
const maxR = Math.max(...ranges);
const panelBase = 282;
const panelH = 38;
const firstRestless = restless.indexOf(true);
---

<figure class="diagram">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Illustration: after a weak close in a restless market, a buy order is placed below the day's low. One order is not reached and expires. The next one fills during a sharp sell-off, and the position is sold at that day's close, above the entry price.">
    {[60, 120, 180].map((gy) => <line class="grid" x1="0" x2={W} y1={gy} y2={gy} />)}

    {candles.map(([o, h, l, c], i) => (
      <g class={`candle ${c >= o ? 'up' : 'down'}`} style={`--i:${i}`}>
        <line x1={X(i)} x2={X(i)} y1={Y(h)} y2={Y(l)} />
        <rect x={X(i) - cw / 2} y={Y(Math.max(o, c))} width={cw} height={Math.max(1.5, Math.abs(Y(o) - Y(c)))} />
      </g>
    ))}

    <g class="miss">
      <line x1={X(missIdx - 1) - 4} x2={X(missIdx) + 14} y1={Y(missLimit)} y2={Y(missLimit)} />
      <path d={`M${X(missIdx) + 18},${Y(missLimit) - 4} l8,8 m0,-8 l-8,8`} />
    </g>

    <line class="limit" x1={X(fillIdx - 1) - 4} x2={X(fillIdx) + 14} y1={Y(limit)} y2={Y(limit)} />

    <circle class="buy" style="--d:1.6s" cx={X(fillIdx)} cy={Y(limit)} r="6" />
    <circle class="sell" style="--d:1.9s" cx={X(fillIdx) + 16} cy={Y(exitPrice)} r="6" />

    <g class="panel">
      <line class="base" x1="20" x2={W - 20} y1={panelBase} y2={panelBase} />
      {ranges.map((r, i) => (
        <rect class={restless[i] ? 'on' : 'off'} style={`--i:${i}`} x={X(i) - cw / 2} y={panelBase - (r / maxR) * panelH} width={cw} height={(r / maxR) * panelH} />
      ))}
    </g>

    <g class="num" style="--d:1.2s"><circle cx={X(missIdx) - 8} cy={Y(missLimit) + 24} r="11" /><text x={X(missIdx) - 8} y={Y(missLimit) + 24}>1</text></g>
    <g class="num" style="--d:1.4s"><circle cx={X(15)} cy={Y(100.9) - 20} r="11" /><text x={X(15)} y={Y(100.9) - 20}>2</text></g>
    <g class="num" style="--d:1.6s"><circle cx={X(fillIdx) - 4} cy={Y(limit) + 28} r="11" /><text x={X(fillIdx) - 4} y={Y(limit) + 28}>3</text></g>
    <g class="num" style="--d:1.9s"><circle cx={X(fillIdx) + 40} cy={Y(exitPrice) - 18} r="11" /><text x={X(fillIdx) + 40} y={Y(exitPrice) - 18}>4</text></g>
    <g class="num" style="--d:1s"><circle cx={X(firstRestless) - 24} cy={panelBase - 24} r="11" /><text x={X(firstRestless) - 24} y={panelBase - 24}>5</text></g>
  </svg>

  <ol class="key">
    <li><strong>Order not reached:</strong> after a weak day, a buy order waits below the low. Price turns before it gets there, so the order expires.</li>
    <li><strong>Setup:</strong> another close below the previous day's low while the market is restless. A new order goes in, again below the low.</li>
    <li><strong>Entry:</strong> the next day the sell-off overshoots and runs into the order.</li>
    <li><strong>Exit:</strong> the day closes above the entry price, and the position is sold at the close.</li>
    <li><strong>Daily ranges:</strong> gold while recent days swing more than usual. Only then are orders placed.</li>
  </ol>
</figure>

<style>
  .diagram {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .candle line {
    stroke: var(--on-dark-muted);
    stroke-width: 1.2;
  }
  .candle rect {
    stroke-width: 1.2;
  }
  .candle.up rect {
    fill: var(--stone);
    stroke: var(--on-dark);
  }
  .candle.down rect {
    fill: var(--on-dark-muted);
    stroke: var(--on-dark-muted);
  }
  .miss line {
    stroke: var(--on-dark-muted);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
  }
  .miss path {
    stroke: var(--on-dark-muted);
    stroke-width: 1.5;
    fill: none;
  }
  .limit {
    stroke: var(--gold);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .buy {
    fill: var(--gold-bright);
    filter: drop-shadow(0 0 6px rgba(230, 201, 136, 0.7));
  }
  .sell {
    fill: var(--stone);
    stroke: var(--on-dark);
    stroke-width: 2;
  }
  .panel .base {
    stroke: var(--rule);
  }
  .panel .off {
    fill: var(--on-dark-muted);
    opacity: 0.35;
  }
  .panel .on {
    fill: var(--gold);
    opacity: 0.85;
  }
  .num circle {
    fill: var(--stone-2);
    stroke: var(--on-dark-muted);
    stroke-width: 1;
  }
  .num text {
    fill: var(--on-dark);
    font: 600 12px var(--sans);
    text-anchor: middle;
    dominant-baseline: central;
  }
  @media (max-width: 40rem) {
    .num circle {
      r: 20px;
    }
    .num text {
      font-size: 22px;
    }
  }

  /* Reveal: candles and range bars appear left to right, then the trade. */
  .candle,
  .panel rect {
    opacity: 0;
  }
  .miss,
  .limit {
    opacity: 0;
  }
  .buy,
  .sell,
  .num {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.3);
  }
  .diagram.drawn .candle,
  .diagram.drawn .panel rect {
    opacity: 1;
    transition: opacity 300ms ease calc(var(--i) * 50ms);
  }
  .diagram.drawn .miss {
    opacity: 1;
    transition: opacity 400ms ease 1.1s;
  }
  .diagram.drawn .limit {
    opacity: 1;
    transition: opacity 400ms ease 1.4s;
  }
  .diagram.drawn .buy,
  .diagram.drawn .sell,
  .diagram.drawn .num {
    opacity: 1;
    transform: none;
    transition:
      opacity 250ms ease-out var(--d, 0s),
      transform 400ms cubic-bezier(0.3, 1.5, 0.6, 1) var(--d, 0s);
  }

  .key {
    margin: 1.5rem 0 0;
    padding-left: 1.4rem;
    color: var(--on-dark-muted);
    font-size: 0.9375rem;
    display: grid;
    gap: 0.35rem;
  }
  .key strong {
    color: var(--on-dark);
    font-weight: 600;
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('figure.diagram');
  if (fig) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          fig.classList.add('drawn');
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(fig);
  }
</script>
