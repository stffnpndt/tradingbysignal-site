---
// Animated background for the hero: faint gold candlestick charts that print
// across dark stone one candle at a time, the newest candle still moving while
// it forms, then slowly fade to make room for new ones. Near the pointer they
// brighten and a fine crosshair follows it. With reduced motion, a still set
// is drawn once.
---

<canvas class="veins" aria-hidden="true"></canvas>

<style>
  .veins {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }
</style>

<script>
  type Candle = { x: number; o: number; h: number; l: number; c: number };
  type Stream = {
    candles: Candle[];
    shown: number; // candles printed so far; the fraction is the forming candle
    speed: number; // candles per frame
    body: number; // body width in px
    born: number;
    life: number; // ms until fully faded, after it finished
    doneAt: number | null;
    alpha: number; // overall strength, so some charts sit further back
  };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.veins');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const host = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0;
    let H = 0;
    let dpr = 1;
    let streams: Stream[] = [];
    let pointer: { x: number; y: number } | null = null;
    let running = false;
    let raf = 0;
    let lastSpawn = 0;

    // Small seeded random so the still (reduced-motion) version is stable.
    let seed = 7;
    const rand = () => {
      seed = (seed * 16807) % 2147483647;
      return (seed - 1) / 2147483646;
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = host.clientWidth;
      H = host.clientHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Price-like candles: a random walk with volatility clusters and trends.
    const makeCandles = (x0: number, y0: number, step: number) => {
      const out: Candle[] = [];
      let vol = 0.8 + rand() * 1.2;
      let drift = (rand() - 0.5) * 0.35;
      let y = y0;
      for (let x = x0; x < W + step; x += step) {
        if (rand() < 0.05) vol = 0.6 + rand() * 2.4; // regime change
        if (rand() < 0.04) drift = (rand() - 0.5) * 0.6;
        const o = y;
        let c = o + drift * step + (rand() - 0.5) * vol * step * 1.4;
        c = Math.max(H * 0.06, Math.min(H * 0.94, c));
        const h = Math.min(o, c) - rand() * vol * step * 0.7;
        const l = Math.max(o, c) + rand() * vol * step * 0.7;
        out.push({ x, o, h, l, c });
        y = c;
      }
      return out;
    };

    const spawn = (now: number) => {
      const step = W < 640 ? 8 : 11;
      streams.push({
        candles: makeCandles(-step, H * (0.15 + rand() * 0.7), step),
        shown: 0,
        speed: 0.05 + rand() * 0.04,
        body: Math.max(3, step * 0.55),
        born: now,
        life: 9000 + rand() * 7000,
        doneAt: null,
        alpha: 0.55 + rand() * 0.45,
      });
    };

    const alphaOf = (s: Stream, now: number) => {
      const fadeIn = Math.min(1, (now - s.born) / 800);
      if (s.doneAt === null) return fadeIn;
      return Math.max(0, 1 - (now - s.doneAt) / s.life) * fadeIn;
    };

    const drawCandle = (k: Candle, body: number, a: number, boost: number) => {
      const up = k.c < k.o; // canvas y grows downward
      const top = Math.min(k.o, k.c);
      const height = Math.max(1, Math.abs(k.c - k.o));
      const gold = boost > 0.3 ? '230, 201, 136' : '195, 160, 90';
      const strength = (0.45 + 0.55 * boost) * a;

      ctx.strokeStyle = `rgba(${gold}, ${strength * 0.8})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(k.x + 0.5, k.h);
      ctx.lineTo(k.x + 0.5, k.l);
      ctx.stroke();

      if (up) {
        ctx.fillStyle = `rgba(27, 28, 30, ${Math.min(1, a * 1.5)})`;
        ctx.fillRect(k.x - body / 2, top, body, height);
        ctx.strokeStyle = `rgba(${gold}, ${strength})`;
        ctx.strokeRect(k.x - body / 2 + 0.5, top + 0.5, body - 1, Math.max(0.5, height - 1));
      } else {
        ctx.fillStyle = `rgba(${gold}, ${strength * 0.7})`;
        ctx.fillRect(k.x - body / 2, top, body, height);
      }
    };

    const draw = (now: number) => {
      ctx.clearRect(0, 0, W, H);

      for (const s of streams) {
        const a = alphaOf(s, now) * s.alpha;
        if (a <= 0) continue;
        const n = Math.min(s.candles.length, Math.floor(s.shown));
        const frac = s.shown - n;

        for (let i = 0; i <= n && i < s.candles.length; i++) {
          let k = s.candles[i];
          if (i === n) {
            // The forming candle: close wanders toward its final value,
            // wicks grow as the period runs.
            if (s.doneAt !== null || frac <= 0) continue;
            const wobble = Math.sin(now / 90 + i) * (k.l - k.h) * 0.12 * (1 - frac);
            const c = k.o + (k.c - k.o) * frac + wobble;
            k = {
              x: k.x,
              o: k.o,
              c,
              h: Math.min(k.o, c) - (Math.min(k.o, k.c) - k.h) * frac,
              l: Math.max(k.o, c) + (k.l - Math.max(k.o, k.c)) * frac,
            };
          }
          let boost = 0;
          if (pointer) {
            const d = Math.hypot(k.x - pointer.x, (k.o + k.c) / 2 - pointer.y);
            boost = Math.max(0, 1 - d / 160);
          }
          drawCandle(k, s.body, a, boost);
        }

        // A soft glow on the forming candle.
        if (s.doneAt === null && n < s.candles.length) {
          const k = s.candles[n];
          const g = ctx.createRadialGradient(k.x, k.o, 0, k.x, k.o, 18);
          g.addColorStop(0, `rgba(246, 226, 176, ${0.35 * a})`);
          g.addColorStop(1, 'rgba(246, 226, 176, 0)');
          ctx.fillStyle = g;
          ctx.fillRect(k.x - 18, k.o - 18, 36, 36);
        }
      }

      if (pointer) {
        ctx.strokeStyle = 'rgba(231, 231, 229, 0.14)';
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 4]);
        ctx.beginPath();
        ctx.moveTo(pointer.x + 0.5, 0);
        ctx.lineTo(pointer.x + 0.5, H);
        ctx.moveTo(0, pointer.y + 0.5);
        ctx.lineTo(W, pointer.y + 0.5);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    };

    const tick = (now: number) => {
      for (const s of streams) {
        if (s.doneAt !== null) continue;
        s.shown = Math.min(s.candles.length, s.shown + s.speed);
        if (s.shown >= s.candles.length) s.doneAt = now;
      }
      streams = streams.filter((s) => s.doneAt === null || alphaOf(s, now) > 0);

      const live = streams.filter((s) => s.doneAt === null).length;
      if (live < 3 && now - lastSpawn > 3500) {
        spawn(now);
        lastSpawn = now;
      }

      draw(now);
      raf = running ? requestAnimationFrame(tick) : 0;
    };

    const start = () => {
      if (running || reduce) return;
      running = true;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    const drawStill = () => {
      streams = [];
      seed = 7;
      const now = performance.now();
      for (let i = 0; i < 3; i++) spawn(now);
      for (const s of streams) {
        s.shown = s.candles.length;
        s.born = now - 1000;
      }
      draw(now + 1000);
    };

    resize();

    if (reduce) {
      drawStill();
    } else {
      // Begin with a few charts already part-printed so the hero is never empty.
      const now = performance.now();
      for (let i = 0; i < 3; i++) {
        spawn(now);
        const s = streams[streams.length - 1];
        s.shown = Math.floor(s.candles.length * (0.2 + rand() * 0.55));
        s.born = now - 1000;
      }
      start();
    }

    new ResizeObserver(() => {
      resize();
      if (reduce) drawStill();
    }).observe(host);

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !document.hidden) start();
      else stop();
    }).observe(host);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    host.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = host.getBoundingClientRect();
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
    });
    host.addEventListener('pointerleave', () => {
      pointer = null;
    });
  }
</script>
