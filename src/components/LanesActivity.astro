---
// Hero rows, variant "activity": for each strategy, the weeks in which it held
// positions in the backtest of today's rules. Brighter = more of its position
// limit in use. Shows that the strategies are busy at different times.
import backtests from '../data/backtests.json';
import { strategies } from '../data/strategies';

type B = { timeInMarket?: number; curve: [string, number, number, number][]; activity?: number[] };
const bt = backtests as unknown as Record<string, B>;

const rows = strategies
  .filter((s) => bt[s.id]?.activity)
  .map((s, i) => ({ id: s.id, name: s.name, d: bt[s.id], i }));

const t0 = Date.parse('2018-01-01');
const t1 = Math.max(...rows.map((r) => Date.parse(r.d.curve[r.d.curve.length - 1][0])));
const W = 1000;
const X = (ms: number) => ((ms - t0) / (t1 - t0)) * W;
const week = (7 * 864e5 / (t1 - t0)) * W;

const years: { label: string; x: number; minor: boolean }[] = [];
for (let y = 2018; y <= new Date(t1).getUTCFullYear(); y++) {
  const x = (X(Date.parse(`${y}-01-01`)) / W) * 100;
  if (x >= 0 && x <= 88) years.push({ label: String(y), x, minor: y % 2 === 1 });
}

// Group weeks by brightness so each row is a handful of paths, not hundreds of nodes.
const bands = rows.map((r) => {
  const steps = [0.2, 0.45, 0.7, 1];
  const paths = steps.map(() => [] as string[]);
  r.d.activity!.forEach((a, j) => {
    if (a <= 0) return;
    const k = steps.findIndex((s) => a <= s);
    const end = Date.parse(r.d.curve[j][0]);
    const x = X(end) - week;
    paths[k === -1 ? 3 : k].push(`M${x.toFixed(1)},0h${(week + 0.6).toFixed(1)}v100h${-(week + 0.6).toFixed(1)}Z`);
  });
  return { ...r, paths: paths.map((p, k) => ({ d: p.join(''), o: [0.28, 0.5, 0.75, 1][k] })).filter((p) => p.d) };
});
const share = (v?: number) => (v === undefined ? '' : `In the market ${Math.round(v * 100)}% of the time`);
---

<figure class="lanes" aria-labelledby="lanes-caption">
  <div class="axis" aria-hidden="true">
    <div class="axis-track">
      {years.map((y) => (
        <span class:list={['year', { edge: y.x < 2, minor: y.minor }]} style={`left:${y.x}%`}>{y.label}</span>
      ))}
      <span class="today" style="left:100%">Today</span>
    </div>
  </div>

  <ol class="rows">
    {bands.map((b) => (
      <li class="row" style={`--i:${b.i}`}>
        <a class="name" href={`#${b.id}`}>
          {b.name}
          <span class="stat">{share(b.d.timeInMarket)}</span>
        </a>
        <div class="track">
          {years.map((y) => (
            <span class="gridline" style={`left:${y.x}%`} aria-hidden="true" />
          ))}
          <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
            {b.paths.map((p) => <path d={p.d} style={`opacity:${p.o}`} />)}
          </svg>
        </div>
      </li>
    ))}
  </ol>

  <figcaption id="lanes-caption">
    When each strategy held positions in the backtest of today’s rules, 2018 to today. Brighter means more of its positions in use.
  </figcaption>
</figure>

<style>
  .lanes {
    margin: 0;
    --label-w: 15rem;
  }
  .axis {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    margin-bottom: 0.5rem;
  }
  .axis-track {
    grid-column: 2;
    position: relative;
    height: 1.25rem;
  }
  .year,
  .today {
    position: absolute;
    top: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }
  .year.edge {
    transform: none;
  }
  .today {
    transform: translateX(-100%);
    color: var(--gold-bright);
    font-weight: 600;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--rule);
    transition: background-color 200ms;
  }
  .row:hover {
    background: rgba(231, 231, 229, 0.03);
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    padding-right: 1rem;
  }
  .name:hover {
    color: var(--gold-bright);
  }
  .stat {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }
  .track {
    position: relative;
    height: 3.75rem;
  }
  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }
  svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    height: 44%;
    width: 100%;
    fill: var(--gold);
    transform-origin: left center;
    animation: grow 1.4s cubic-bezier(0.45, 0.05, 0.25, 1) both;
    animation-delay: calc(var(--i) * 140ms + 150ms);
  }
  .row:hover svg {
    fill: var(--gold-bright);
  }
  figcaption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @keyframes grow {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    svg {
      animation: none;
    }
  }
  @media (max-width: 40rem) {
    .lanes {
      --label-w: 0px;
    }
    .axis {
      grid-template-columns: 1fr;
    }
    .axis-track {
      grid-column: 1;
    }
    .row {
      grid-template-columns: 1fr;
      padding-top: 0.75rem;
    }
    .name {
      padding: 0;
    }
    .year.minor {
      display: none;
    }
    .track {
      height: 3rem;
    }
  }
</style>
