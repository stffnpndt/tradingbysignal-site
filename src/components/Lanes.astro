---
// Timeline: one lane per strategy, drawn from the day it went live to today.
import { strategies } from '../data/strategies';

const start = new Date('2025-07-01T00:00:00Z');
const today = new Date();
const span = today.getTime() - start.getTime();
const pct = (d: Date) => ((d.getTime() - start.getTime()) / span) * 100;

const years: { label: string; x: number }[] = [
  { label: new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(start), x: 0 },
];
for (let y = start.getUTCFullYear(); y <= today.getUTCFullYear(); y++) {
  const x = pct(new Date(Date.UTC(y, 0, 1)));
  if (x > 8 && x <= 92) years.push({ label: String(y), x });
}

const fmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const lanes = strategies.map((s, i) => {
  const d = new Date(`${s.liveSince}T00:00:00Z`);
  return { ...s, x: pct(d), since: fmt.format(d), i };
});
---

<figure class="lanes" aria-labelledby="lanes-caption">
  <div class="axis" aria-hidden="true">
    <div class="axis-track">
      {years.map((y) => (
        <span class:list={['year', { edge: y.x < 4 }]} style={`left:${y.x}%`}>{y.label}</span>
      ))}
      <span class="today" style="left:100%">Today</span>
    </div>
  </div>

  <ol class="rows">
    {lanes.map((l) => (
      <li class="row" style={`--i:${l.i}`}>
        <a class="name" href={`#${l.id}`}>{l.name}</a>
        <div class="track">
          {years.map((y) => (
            <span class="gridline" style={`left:${y.x}%`} aria-hidden="true" />
          ))}
          <span class="line" style={`left:${l.x}%`} aria-hidden="true" />
          <span class="start" style={`left:${l.x}%`} aria-hidden="true" />
          <span class:list={['since', { flip: l.x > 60 }]} style={`left:${l.x}%`}>Live since {l.since}</span>
        </div>
      </li>
    ))}
  </ol>

  <figcaption id="lanes-caption">
    Each line runs from the day a strategy started trading real money until today.
  </figcaption>
</figure>

<style>
  .lanes {
    margin: 0;
    --label-w: 15rem;
  }

  .axis {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    margin-bottom: 0.5rem;
  }
  .axis-track {
    grid-column: 2;
    position: relative;
    height: 1.25rem;
  }
  .year,
  .today {
    position: absolute;
    top: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }
  .year.edge {
    transform: none;
  }
  .today {
    transform: translateX(-100%);
    color: var(--gold-bright);
    font-weight: 600;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    align-items: center;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .name {
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    padding-right: 1rem;
  }
  .name:hover {
    color: var(--gold-bright);
  }
  .row {
    transition: background-color 200ms;
  }
  .row:hover {
    background: rgba(231, 231, 229, 0.03);
  }
  .row:hover .line {
    box-shadow: 0 0 14px 1px rgba(230, 201, 136, 0.55);
  }

  .track {
    position: relative;
    height: 3.5rem;
  }
  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }
  .line {
    position: absolute;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--gold-bright), var(--gold) 30%, var(--gold));
    box-shadow: 0 0 8px rgba(230, 201, 136, 0.3);
    transition: box-shadow 200ms;
    transform-origin: left center;
    animation: draw 900ms cubic-bezier(0.22, 0.8, 0.3, 1) both;
    animation-delay: calc(var(--i) * 140ms + 150ms);
  }
  .start {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--gold-bright);
    box-shadow: 0 0 0 4px var(--stone), 0 0 12px 3px rgba(230, 201, 136, 0.5);
  }
  .since {
    position: absolute;
    bottom: 0.2rem;
    margin-left: -6px;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .since.flip {
    margin-left: 0;
    transform: translateX(calc(-100% - 10px));
  }

  figcaption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .lanes {
      --label-w: 0px;
    }
    .axis {
      grid-template-columns: 1fr;
    }
    .axis-track {
      grid-column: 1;
    }
    .row {
      grid-template-columns: 1fr;
      padding-top: 0.75rem;
    }
    .name {
      padding: 0;
    }
    .track {
      height: 3rem;
    }
    .since {
      bottom: 0;
    }
  }
</style>
