---
// Layout for plain text pages (legal notice, privacy, disclaimer):
// slim dark header band with the page title, then readable prose on grey.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} | Trading B(u)y Signal`} description={description}>
  <section class="head dark grain">
    <header class="site-header wrap">
      <a class="wordmark" href="/">Trading B(u)y Signal</a>
      <a class="back" href="/">Back to start page</a>
    </header>
    <div class="wrap">
      <h1>{title}</h1>
    </div>
  </section>

  <article class="prose wrap">
    <slot />
    {updated && <p class="updated">Last updated: {updated}</p>}
  </article>
</Base>

<style>
  .head {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem clamp(2.5rem, 7vw, 4.5rem);
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .back {
    font-size: 0.9375rem;
    color: var(--on-dark-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--gold-bright);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.02em;
    color: #f2f1ee;
  }

  .prose {
    padding-block: clamp(3rem, 7vw, 5rem) 2rem;
    max-width: min(44rem, 100% - 2.5rem);
    margin-inline: auto;
    color: var(--ink-soft);
  }
  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.75rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 2.75rem 0 0.75rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(address) {
    margin: 0 0 1rem;
  }
  .prose :global(address) {
    font-style: normal;
    color: var(--ink);
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.375rem;
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .updated {
    margin-top: 2.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
